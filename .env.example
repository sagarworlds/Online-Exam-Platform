# Postgres (used by apps/api and docker-compose)
POSTGRES_USER=examplatform
POSTGRES_PASSWORD=examplatform
POSTGRES_DB=examplatform

# apps/api (ASP.NET Core)
ASPNETCORE_ENVIRONMENT=Development
# Dev-only placeholder; never reuse this value outside local development.
JWT_SIGNING_KEY=dev-only-insecure-signing-key-change-before-any-real-deployment
