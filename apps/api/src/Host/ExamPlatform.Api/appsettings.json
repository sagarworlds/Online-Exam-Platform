{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "exam-platform",
    "Audience": "exam-platform-clients"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Identity": {
    "RateLimits": {
      "OtpRequest": { "PermitLimit": 20, "WindowSeconds": 300 },
      "OtpVerify": { "PermitLimit": 30, "WindowSeconds": 300 },
      "PasswordLogin": { "PermitLimit": 10, "WindowSeconds": 300 },
      "PasswordReset": { "PermitLimit": 5, "WindowSeconds": 900 }
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
