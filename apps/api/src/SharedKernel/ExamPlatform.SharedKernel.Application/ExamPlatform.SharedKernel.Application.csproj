<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Needed for IEndpointRouteBuilder/IServiceCollection/IConfiguration used by IModuleInstaller,
         so this stays a plain library (no Web SDK) while still seeing ASP.NET Core types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExamPlatform.SharedKernel.Domain\ExamPlatform.SharedKernel.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The font the PDF writer embeds for Devanagari text, and its licence (FR-38). See Pdf/Fonts/README.md. -->
    <EmbeddedResource Include="Pdf\Fonts\NotoSansDevanagari-Regular.ttf" LogicalName="ExamPlatform.SharedKernel.Application.Pdf.Fonts.NotoSansDevanagari-Regular.ttf" />
    <EmbeddedResource Include="Pdf\Fonts\OFL.txt" LogicalName="ExamPlatform.SharedKernel.Application.Pdf.Fonts.OFL.txt" />
  </ItemGroup>
</Project>
